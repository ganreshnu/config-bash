# $spack/opt/spack/gpg
# $spack/var/spack/cache
# /tmp/$user/spack-stage
ls='ls --color=auto --group-directories-first'
alias ls="$ls"
alias ll="$ls -l --human-readable"
alias la="$ls --almost-all"
alias lla="$ls -l --human-readable --almost-all"
alias lt="$ls --almost-all --human-readable --size -1 -S --classify"

alias mnt="mount | awk -F' ' '{ printf \"%s\t%s\n\",\$1,\$3; }' | column -t | grep -E ^/dev/ | sort"

alias cpv='rsync --archive --human-readable --info=PROGRESS2'

alias spack='podman run --rm -it -v ${XDG_CACHE_HOME:-$HOME/.cache}/spack:/cache -v $(mkdir -p /tmp/spack-stage && echo /tmp/spack-stage):/stage -v ${HOME}/Spack/spack-gpg:/gpg -v $PWD:$PWD -w $PWD spack'

alias prun='podman run --rm -it -v "$PWD":"$PWD" -w "$PWD"'
alias picocom='picocom -b 115200'
# alias cargo='podman run --rm -ti -v /usr/lib/pkgconfig:/usr/lib/pkgconfig -v "$PWD":"$PWD" -w "$PWD" rust cargo'

if [[ -r "$HOME/.aliases" ]]; then
	. "$HOME/.aliases"
fi

Qemu() {
	local -r disk_file=/tmp/qemu-disk.raw
	local qemu_args=(
		-machine 'q35,accel=kvm,vmport=auto,nvdimm=on,hmat=on,kernel-irqchip=split'
		-cpu max
		-m 16G
		-smp 8
		-nodefaults

		-device 'intel-iommu,intremap=on'

		-drive 'if=pflash,format=raw,unit=0,file=/usr/share/edk2-ovmf/x64/OVMF.4m.fd,readonly=on'
		-drive 'if=pflash,format=raw,unit=1,file='"$HOME"'/.var/OVMF_VARS.fd'

		# -vga virtio
		-vga qxl
		-spice 'port=5900,disable-ticketing=on'

		-device qemu-xhci
		-device usb-kbd
		-serial stdio

		-nic 'user,model=virtio-net-pci'
		# -boot menu=on
	)
	[[ -f "$*" ]] && qemu_args+=(
		-drive 'if=none,id=usbstick,format=raw,file='"$*"
		-device 'usb-storage,drive=usbstick'
	)
	[[ -f "$disk_file" ]] && qemu_args+=(
		-drive 'if=none,id=nvm,format=raw,file='"$disk_file"
		-device 'nvme,serial=deadbeef,drive=nvm'
	)
	# -drive if=virtio,format=raw,file="${*}"
	# -device virtio-gpu-gl,hostmem=8G,blob=true,venus=true

	hyprctl dispatch 'hl.dsp.exec_raw("remote-viewer spice://localhost:5900")'
	qemu-system-x86_64 "${qemu_args[@]}"
}

